# steamcouch: run the couch dashboard instead of the Steam UI.
#
# Installed by the image as /etc/gamescope-session-plus/sessions.d/ogui-steam
# (sourced by gamescope-session-plus after the system session file).
#
# Per user:
#   ~/.config/steamcouch/disable                 always use Steam Gaming Mode
#   ~/.local/share/steamcouch/use-steam-once     use Steam Gaming Mode once
#                                                (set by "Steam Gaming Mode")

if [ -f "$HOME/.config/steamcouch/disable" ]; then
  :
elif [ -f "$HOME/.local/share/steamcouch/use-steam-once" ]; then
  rm -f "$HOME/.local/share/steamcouch/use-steam-once"
elif [ -x /usr/libexec/steamcouch-session ]; then
  CLIENTCMD="/usr/libexec/steamcouch-session"
fi
