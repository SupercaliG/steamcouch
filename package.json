{
  "name": "steamcouch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Console-style couch dashboard for a Linux living-room PC",
  "author": "SupercaliG",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build -c vite.main.config.ts",
    "package:linux": "npm run build && electron-builder --linux dir --x64"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "dev.steamcouch.dashboard",
    "productName": "steamcouch",
    "executableName": "steamcouch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/padgrab.py",
        "to": "padgrab.py"
      }
    ],
    "linux": {
      "target": "dir",
      "category": "Game"
    }
  }
}
